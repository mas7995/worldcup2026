# worldcupapi.com API key — used for live score sync and reseed
WORLDCUP_API_KEY=

# Admin panel PIN (default: 2026)
ADMIN_PIN=2026

# Server port (default: 3001)
PORT=3001

# Path to the SQLite database file.
# LOCAL: leave blank — defaults to server/worldcup.db
# CLOUD (Railway/Fly.io/Render): point to a persistent volume so data
# survives re-deploys. e.g. DB_PATH=/data/worldcup.db
DB_PATH=
